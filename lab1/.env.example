# Необязательно: токен GitHub поднимает лимит API с 60 до 5000 запросов в час.
# Один запуск grabber'а тратит 5 запросов.
GITHUB_TOKEN=

# Ключи API Langfuse (трассировка, configs/config.yaml → langfuse). Заполняет `python langfuse/make_env.py`.
# Пусто — трассировка выключена, всё остальное работает.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
