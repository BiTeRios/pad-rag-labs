# retrieval-service (uvicorn retrieval_service.main:create_app --factory --port 8005)
INDEXING_URL=http://localhost:8004
INFERENCE_URL=http://localhost:8003
TOP_K=5
CANDIDATES=20
SCORE_THRESHOLD=0.78
DEDUP_THRESHOLD=0.8
MIN_CHARS=50
MAX_PER_DOCUMENT=0
RERANKER_ENABLED=true
RERANK_MIN_SCORE=0.1
RERANK_FALLBACK=true
LOG_LEVEL=INFO
