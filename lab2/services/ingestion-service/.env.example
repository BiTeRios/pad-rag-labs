# ingestion-service (uvicorn ingestion_service.main:create_app --factory --port 8002)
DATABASE_URL=postgresql+asyncpg://ingestion:ingestion@localhost:5432/ingestion
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
GITHUB_REPO=kubernetes/website
GITHUB_REF=main
DOCS_ROOT=content/en/docs
SECTIONS=concepts,tasks,tutorials
EXTENSIONS=.md
SITE_URL=https://kubernetes.io/docs
GITHUB_TOKEN=
HTTP_TIMEOUT_S=30
MAX_RETRIES=3
MAX_WORKERS=8
FETCH_LIMIT=0
SYNC_INTERVAL_MINUTES=0
LOG_LEVEL=INFO
EVENT_BATCH_SIZE=50
