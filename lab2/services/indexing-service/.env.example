# indexing-service (uvicorn indexing_service.main:create_app --factory --port 8004)
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
QDRANT_URL=http://localhost:6333
INGESTION_URL=http://localhost:8002
INFERENCE_URL=http://localhost:8003
CHUNK_STRATEGY=heading
CHUNK_SIZE=1000
CHUNK_OVERLAP=0
INCLUDE_HEADING=true
FETCH_BATCH=50
EMBED_BATCH=64
RECONCILE_ON_STARTUP=true
LOG_LEVEL=INFO
# QDRANT_PATH=.local/qdrant — локальный режим вместо сервера (запуск без Docker)
