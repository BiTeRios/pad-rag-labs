# chat-service (uvicorn chat_service.main:create_app --factory --port 8006)
DATABASE_URL=postgresql+asyncpg://chat:chat@localhost:5432/chat
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RETRIEVAL_URL=http://localhost:8005
LLM_BASE_URL=http://localhost:11434
LLM_MODEL=qwen3:8b
LLM_THINK=false
LLM_TEMPERATURE=0.1
LLM_NUM_CTX=8192
LLM_SEED=42
LLM_TIMEOUT_S=120
PROMPT_NAME=strict
LOG_LEVEL=INFO
