# Секреты и параметры docker compose. Скопируйте в .env и задайте свои значения; .env в git не попадает.

# PostgreSQL: суперпользователь и отдельный пароль для БД каждого сервиса
POSTGRES_PASSWORD=change-me-postgres
AUTH_DB_PASSWORD=change-me-auth
INGESTION_DB_PASSWORD=change-me-ingestion
CHAT_DB_PASSWORD=change-me-chat
ANALYTICS_DB_PASSWORD=change-me-analytics

RABBITMQ_USER=rag
RABBITMQ_PASSWORD=change-me-rabbitmq

# Подпись JWT (auth-service выпускает, gateway проверяет): не короче 32 символов
JWT_SECRET=change-me-to-a-long-random-string-32+
TOKEN_TTL_MINUTES=60
# Первый администратор (создаётся при старте auth-service)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-admin

# --- Необязательно ---
# Без токена GitHub API даёт 60 запросов в час
GITHUB_TOKEN=
# Не больше N документов за синхронизацию (быстрая проверка); 0 — все
FETCH_LIMIT=0
# Периодическая синхронизация; 0 — только по запросу admin
SYNC_INTERVAL_MINUTES=0
LLM_MODEL=qwen3:8b
LLM_BASE_URL=http://host.docker.internal:11434
RERANKER_ENABLED=true
# Кэш весов моделей: том models или путь к ~/.cache/huggingface (не скачивать заново);
# HF_HUB_OFFLINE=1 — не обращаться к Hugging Face, если веса уже в кэше
HF_CACHE=models
HF_HUB_OFFLINE=0
RATE_LIMIT_PER_MINUTE=120
LOG_LEVEL=INFO
